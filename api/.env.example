NODE_ENV=development
PORT=4000

# Comma-separated origins allowed by CORS, or * for all.
CORS_ORIGIN=*

# PostgreSQL connection string (Prisma).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kalopehomes?schema=public"

# Auth — JWT
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Default super-admin created by the seed script.
SEED_ADMIN_EMAIL="admin@kalopehomes.com"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="Super Admin"
