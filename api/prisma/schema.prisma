// Kalope Homes — Prisma schema
// Architecture: a Livspace-style interior-design platform.
//   * Catalog + CMS content is authored in the ADMIN app and consumed by the WEB app.
//   * There is NO cart/checkout. Browsing generates LEADS which flow into a
//     quotation pipeline (Lead -> Quote) handled by the CRM app.
//   * Access is governed by role-based permissions (RBAC).

generator client {
  provider = "prisma-client-js"
  // `native` for local dev; `rhel-openssl-3.0.x` for Vercel's serverless
  // runtime (Amazon Linux 2023) so the query engine binary is present there.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Publishing lifecycle for any web-facing content.
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// What kind of inquiry a lead represents.
enum LeadType {
  CONSULTATION
  QUOTE_REQUEST
  CONTACT
  CALLBACK
}

/// Where a lead originated.
enum LeadSource {
  WEBSITE
  PHONE
  REFERRAL
  WALK_IN
  SOCIAL
  CAMPAIGN
  OTHER
}

/// Sales pipeline stage for a lead (owned by the CRM team).
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

/// Lifecycle of a quotation.
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  REVISED
}

/// Timeline entry types on a lead.
enum ActivityType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  SITE_VISIT
  STATUS_CHANGE
  QUOTE_SENT
}

/// Where a banner/hero slide is rendered on the web app.
enum BannerPlacement {
  HOME_HERO
  HOME_PROMO
  CATEGORY_HEADER
}

// ---------------------------------------------------------------------------
// RBAC — Users & Roles
// ---------------------------------------------------------------------------

/// A role bundles a set of permission strings (e.g. "product:write").
/// Seeded system roles cannot be deleted.
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Reverse relations (CRM ownership + authorship)
  assignedLeads Lead[]         @relation("LeadAssignee")
  activities    LeadActivity[]
  createdQuotes Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Catalog — Categories, Products, Rooms, Styles
// ---------------------------------------------------------------------------

/// Hierarchical taxonomy: top-level offerings (e.g. "Modular Kitchen",
/// "Full Home Interiors") with optional sub-categories via self-relation.
model Category {
  id              String        @id @default(uuid())
  name            String
  slug            String        @unique
  description     String?
  imageUrl        String?
  iconUrl         String?
  sortOrder       Int           @default(0)
  status          ContentStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  metaTitle       String?
  metaDescription String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]
  projects Project[]
  leads    Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

/// Room / space type used to tag designs (Kitchen, Living Room, Bedroom...).
model Room {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  imageUrl    String?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  products    ProductRoom[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("rooms")
}

/// Design style tag (Modern, Contemporary, Rustic...).
model Style {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  imageUrl    String?
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  products    ProductStyle[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("styles")
}

/// A catalog/design item. Not sold directly — it drives quote requests.
/// `startingPrice` + `priceUnit` power the "starting at ₹X onwards" estimator;
/// `specs` holds flexible attributes (layout, finish, dimensions...).
model Product {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  sku              String?       @unique
  shortDescription String?
  description      String?
  startingPrice    Decimal?      @db.Decimal(12, 2)
  priceUnit        String? // e.g. "per sq ft", "onwards"
  currency         String        @default("INR")
  specs            Json? // flexible key/value attributes
  status           ContentStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  sortOrder        Int           @default(0)
  metaTitle        String?
  metaDescription  String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images ProductImage[]
  rooms  ProductRoom[]
  styles ProductStyle[]
  leads  Lead[]
  quoteItems QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

/// Ordered image gallery for a product (URLs only — no binary storage).
model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
  @@map("product_images")
}

/// Join: Product <-> Room (many-to-many).
model ProductRoom {
  productId String
  roomId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([productId, roomId])
  @@map("product_rooms")
}

/// Join: Product <-> Style (many-to-many).
model ProductStyle {
  productId String
  styleId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  style     Style   @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([productId, styleId])
  @@map("product_styles")
}

// ---------------------------------------------------------------------------
// CMS — Homepage & marketing content
// ---------------------------------------------------------------------------

/// Homepage hero carousel / promotional banners.
model HeroSlide {
  id             String          @id @default(uuid())
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  ctaText        String?
  ctaLink        String?
  placement      BannerPlacement @default(HOME_HERO)
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([placement])
  @@map("hero_slides")
}

model Testimonial {
  id               String   @id @default(uuid())
  authorName       String
  authorLocation   String?
  authorAvatarUrl  String?
  rating           Int? // 1..5
  quote            String
  imageUrl         String? // project photo shown alongside
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("testimonials")
}

/// Delivered-project / portfolio showcase (case study).
model Project {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  location      String?
  area          String? // e.g. "1450 sq ft"
  configuration String? // e.g. "3 BHK"
  description   String?
  coverImageUrl String?
  status        ContentStatus @default(DRAFT)
  isFeatured    Boolean       @default(false)
  sortOrder     Int           @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images ProjectImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("projects")
}

model ProjectImage {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([projectId])
  @@map("project_images")
}

/// Ordered image collection used by the website gallery.
model Gallery {
  id         String        @id @default(uuid())
  title      String
  description String?
  imageUrls  String[]      @default([])
  status     ContentStatus @default(DRAFT)
  isFeatured Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@index([isFeatured])
  @@map("gallery")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String? // grouping label, e.g. "Pricing"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

/// Global site configuration as typed key/value (phone, socials, stats...).
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  group     String? // e.g. "contact", "seo", "stats"
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Quotation pipeline — Leads & Quotes (CRM domain)
// ---------------------------------------------------------------------------

/// An inquiry captured from the web app. Entry point of the quotation flow.
model Lead {
  id           String     @id @default(uuid())
  referenceNo  String     @unique
  type         LeadType   @default(QUOTE_REQUEST)
  name         String
  email        String?
  phone        String
  city         String?
  message      String?
  propertyType String? // e.g. "3 BHK Apartment"
  budgetRange  String? // e.g. "5-10 Lakhs"
  roomsInterested String[] @default([])
  source       LeadSource @default(WEBSITE)
  status       LeadStatus @default(NEW)

  assignedToId String?
  assignedTo   User?     @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  preferredContactAt DateTime?

  activities LeadActivity[]
  quotes     Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedToId])
  @@index([type])
  @@map("leads")
}

/// Timeline of interactions on a lead.
model LeadActivity {
  id     String       @id @default(uuid())
  leadId String
  lead   Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type   ActivityType @default(NOTE)
  note   String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

/// A quotation issued against a lead. Line items reference products optionally.
model Quote {
  id          String      @id @default(uuid())
  quoteNumber String      @unique
  leadId      String
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status      QuoteStatus @default(DRAFT)

  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  taxPercent Decimal @default(0) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)
  currency  String  @default("INR")

  notes      String?
  validUntil DateTime?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  items QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title       String
  description String?
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unit        String?
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder   Int      @default(0)

  @@index([quoteId])
  @@map("quote_items")
}
